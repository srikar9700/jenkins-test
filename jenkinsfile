pipeline {
    agent any
    environment {
        GITHUB_TOKEN = credentials('srikar9700') 
    }

    stages {
        stage('1.GIT Checkout') {
            steps {
                script {
                    // Start a GitHub check run
                    githubChecks(
                        name: 'Checkout',
                        status: 'in_progress',
                        conclusion: 'in_progress',
                        description: 'Starting the checkout stage'
                    )

                    // Perform Git checkout
                    checkout scm

                    // Update GitHub check with success status and details URL
                    githubChecks(
                        name: 'Checkout',
                        status: 'completed',
                        conclusion: 'success',
                        description: 'Checkout complete',
                        detailsUrl: "http://localhost:8080/job/multi-branch-pipeline/job/dev/${env.BUILD_NUMBER}/console"
                    )
                }
            }
        }

        stage('2. build and test') {
            steps {
                sh "export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64; mvn clean package"
            }
        }

        stage('3. code coverage') {
            steps {
                sh "export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64; mvn jacoco:report"
            }

        }

        stage('4. SCA') {
            steps {
                sh "export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64; mvn org.owasp:depedency-check-maven:check"
            }
        }
    }
}